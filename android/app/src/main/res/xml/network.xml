<?xml version="1.0" encoding="utf-8"?>
<!-- https only, with the system's certificates (the Spark behind a reverse proxy with a real certificate) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
