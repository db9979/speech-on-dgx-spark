<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spark-Begleiter für Windows: Tray-Programm für den eigenen Spark – Schreibhilfe (Strg+Alt+S),
    Frag Spark (Strg+Alt+A), Diktieren (Strg+Alt+D), Meldungen, Zustandspunkt und Mein-Notaus-Knopf;
    dazu Rechtsklick auf Dateien, Bildschirm fragen (Strg+Alt+B), App erkennen, Antwort entwerfen in Outlook
    (Strg+Alt+M), Ordner Spark-Wissen, Knöpfe in Meldungen, Spark darf am PC handeln und Weckwort.
    Welche Teile an sind, legt das Panel fest (Ich → Begleiter); die Tastenkürzel werden lokal eingestellt.
    Gebaut von .github/workflows/begleiter-windows.yml für win-x64 und win-arm64.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Erlaubt das Bauen (nicht Ausführen) auf Linux/macOS, z. B. für schnelle Prüfungen. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>SparkBegleiter</AssemblyName>
    <RootNamespace>SparkBegleiter</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Spark-Begleiter</Product>
    <Description>Spark-Begleiter für Windows</Description>
    <NeutralLanguage>de-DE</NeutralLanguage>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Einzelne .exe (selbstständig, ohne installiertes .NET): komprimiert, sonst wäre sie ~150 MB groß. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
