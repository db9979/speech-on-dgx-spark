      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to Spark"
          }
        }
      }
    },
    "Zeigt, wo gerade zugehört wird, und beendet es.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows where the Spark is listening right now and ends it."
          }
        }
      }
    },
