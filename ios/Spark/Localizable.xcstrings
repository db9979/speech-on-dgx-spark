      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On battery"
          }
        }
      }
    },
    "Am PC: den QR-Code mit der Kamera dieses iPhones scannen. Auf diesem iPhone: dort „in der App öffnen“ antippen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a computer: scan the QR code with this iPhone’s camera. On this iPhone: tap “open in the app” there."
          }
        }
      }
    },
