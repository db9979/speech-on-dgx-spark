    "Erneut versuchen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "Es gibt mehrere Kontakte „%@“. Sag bitte den ganzen Namen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are several contacts “%@”. Please say the full name."
          }
        }
      }
    },
    "Es warten schon zehn Fragen. Diese ist nicht gespeichert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten questions are already waiting. This one is not saved."
          }
        }
      }
    },
    "Fehler %lld vom Spark.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error %lld from the Spark."
          }
        }
      }
    },
    "Fehler beim Spark.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error at the Spark."
