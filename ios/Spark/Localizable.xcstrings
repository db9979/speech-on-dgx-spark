    "Abgelegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored."
          }
        }
      }
    },
    "Am Akku": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On battery"
          }
        }
      }
    },
    "Am PC: den QR-Code mit der Kamera dieses iPhones scannen. Auf diesem iPhone: dort „in der App öffnen“ antippen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a computer: scan the QR code with this iPhone’s camera. On this iPhone: tap “open in the app” there."
          }
        }
      }
    },
    "Anhang": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachment"
          }
        }
      }
    },
    "Anhang entfernen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove attachment"
          }
        }
      }
    },
    "Antippen und losreden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and start talking"
          }
        }
      }
    },
    "Antworten": {
      "localizations": {
