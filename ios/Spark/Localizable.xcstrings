      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Greeting"
          }
        }
      }
    },
    "Bereit?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready?"
          }
        }
      }
    },
    "Bereite vor …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing …"
          }
        }
      }
    },
    "Bus und Bahn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bus and train"
          }
        }
      }
    },
    "Code aus der Authenticator-App": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code from the authenticator app"
          }
        }
      }
    },
    "Dafür im Panel unter Ich → iPhone-App „Dokumente aus der App“ einschalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For this, turn on “Documents from the app” in the panel under Me → iPhone app."
          }
        }
      }
    },
    "Dafür im Panel „Von selbst“ für dein Profil einschalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For this, switch on “By itself” for your profile in the panel."
          }
        }
      }
    },
    "Das Dokument gibt es nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That document does not exist."
          }
        }
      }
    },
    "Das Foto ist zu groß für den Spark.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is too big for the Spark."
          }
        }
      }
    },
    "Das Foto kann ich nicht laden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cannot load the photo."
          }
        }
      }
    },
    "Das Update hat nicht geklappt. Der Spark läuft weiter mit der alten Version; Details im Panel unter Zustand → System/Update.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update did not work. The Spark keeps running the old version; details in the panel under Status → System/Update."
          }
        }
      }
    },
    "Das Weckwort erkennt das iPhone selbst, ohne Internet. Erst danach geht etwas an deinen Spark. Am Akku hört es nach der letzten Nutzung nur so lange zu wie eingestellt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone recognises the wake word itself, without the internet. Only then does anything go to your Spark. On battery it listens only as long as set after the last use."
          }
        }
      }
    },
    "Das Ziel verstehe ich nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I do not understand the destination."
          }
        }
      }
    },
    "Das bisherige Gespräch vergessen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget the conversation so far"
          }
        }
      }
    },
    "Das ist kein gültiger Kopplungs-Link vom Spark.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a valid pairing link from the Spark."
          }
        }
      }
    },
    "Datei": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        }
      }
    },
    "Dauerhaft zuhören": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening all the time"
          }
        }
      }
    },
    "Den Namen finde ich nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cannot find that name."
          }
        }
      }
    },
    "Den Namen finde ich nicht. Ähnlich: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cannot find that name. Similar: %@."
          }
        }
      }
    },
    "Denke nach …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking …"
          }
        }
      }
    },
    "Der Assistent ist währenddessen kurz nicht erreichbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant is briefly unreachable meanwhile."
          }
        }
      }
    },
    "Der Code gilt nur einmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code works only once."
          }
        }
      }
    },
    "Der Code stimmt nicht. Bitte den aktuellen Code aus der Authenticator-App nehmen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is not right. Please use the current code from the authenticator app."
          }
        }
      }
    },
    "Der Spark erinnert dich, mit Push und auf allen Geräten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Spark reminds you, with push and on all devices."
          }
        }
      }
    },
    "Der Spark hat das Foto nicht angenommen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Spark did not accept the photo."
          }
        }
      }
    },
    "Der Spark hat keinen Schlüssel geschickt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Spark sent no key."
          }
        }
      }
    },
    "Der Spark ist aktuell.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Spark is up to date."
          }
        }
      }
    },
    "Der Spark ist gerade ausgelastet. Bitte gleich noch einmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Spark is busy right now. Please try again in a moment."
          }
        }
      }
    },
    "Der Spark nimmt dieses iPhone nicht an. Im Panel unter Ich → iPhone-App prüfen, ob die App an ist, sonst neu koppeln.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Spark does not accept this iPhone. Check in the panel under Me → iPhone app that the app is on, otherwise pair again."
          }
        }
      }
    },
    "Der Spark sieht es sich an": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Spark looks at it"
          }
        }
      }
    },
    "Die App darf deine Kontakte nicht lesen. Einstellungen → Spark → Kontakte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app may not read your contacts. Settings → Spark → Contacts."
          }
        }
      }
    },
    "Die App darf nicht in Erinnerungen schreiben. Einstellungen → Spark → Erinnerungen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app may not write to Reminders. Settings → Spark → Reminders."
          }
        }
      }
    },
    "Die App ist noch nicht mit dem Spark gekoppelt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not paired with the Spark yet."
          }
        }
      }
    },
    "Die Datei ist zu groß (höchstens 20 MB).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too big (20 MB at most)."
          }
        }
      }
    },
    "Die Datei kann ich nicht lesen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cannot read the file."
          }
        }
      }
    },
    "Die Erinnerungen-App hat kein Konto für neue Listen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Reminders app has no account for new lists."
          }
        }
      }
    },
    "Die Nachricht gibt es nicht mehr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That message no longer exists."
          }
        }
      }
    },
    "Die Nachricht ist leer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message is empty."
          }
        }
      }
    },
    "Die Nummer verstehe ich nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I do not understand the number."
          }
        }
      }
    },
    "Die Spracherkennung auf dem iPhone kann diese Sprache nicht ohne Internet. Das Weckwort bleibt aus (Einstellungen → Allgemein → Tastatur → Diktat).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition on the iPhone cannot do this language without the internet. The wake word stays off (Settings → General → Keyboard → Dictation)."
          }
        }
      }
    },
    "Die Spracherkennung oder das Sprachmodell läuft gerade nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition or the language model is not running right now."
          }
        }
      }
    },
    "Die Wünsche zum Ton änderst du im Panel, weil sie dem Sprachmodell gesagt werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You change the wishes for the tone in the panel, because the language model is told them."
          }
        }
      }
    },
    "Diese App spricht mit deinem Spark. Zum Koppeln im Panel unter Ich → iPhone-App auf „iPhone koppeln“ tippen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app talks to your Spark. To pair, tap “Pair an iPhone” in the panel under Me → iPhone app."
          }
        }
      }
    },
    "Dokument": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Document"
          }
        }
      }
    },
