      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detailed"
          }
        }
      }
    },
    "Ausgegraute Themen schaltest du zuerst im Panel ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch on greyed-out topics in the panel first."
          }
        }
      }
    },
    "Beenden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End"
          }
