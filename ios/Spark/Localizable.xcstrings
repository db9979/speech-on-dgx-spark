          "stringUnit": {
            "state": "translated",
            "value": "The sign-in lasts only while the app is open."
          }
        }
      }
    },
    "Die App darf das Mikrofon nicht benutzen (Einstellungen → Spark).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app may not use the microphone (Settings → Spark)."
