    "Auf dem Bild habe ich keinen Text gefunden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I found no text in the picture."
          }
        }
      }
    },
    "Auf die Liste": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to the list"
          }
        }
      }
    },
    "Auf die Liste beim Spark": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to a Spark list"
          }
        }
      }
    },
    "Auf diesem iPhone ist keine Code-Sperre eingerichtet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone has no passcode set up."
