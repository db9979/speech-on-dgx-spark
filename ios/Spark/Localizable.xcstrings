    "Erinnere mich %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me %@"
          }
        }
      }
    },
    "Erinnerung beim Spark": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder at the Spark"
          }
        }
      }
    },
    "Erinnerung: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
