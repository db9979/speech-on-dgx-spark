        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognising speech …"
          }
        }
      }
    },
    "Erneut versuchen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "Erreichbar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachable"
          }
        }
      }
    },
    "Erst eine Sicherung, dann die neue Version. Du bestätigst mit Face ID und dem Code aus deiner Authenticator-App.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First a backup, then the new version. You confirm with Face ID and the code from your authenticator app."
          }
        }
      }
    },
    "Es gibt mehrere Kontakte „%@“. Sag bitte den ganzen Namen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are several contacts “%@”. Please say the full name."
          }
        }
      }
    },
    "Es warten schon zehn Fragen. Diese ist nicht gespeichert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten questions are already waiting. This one is not saved."
          }
        }
      }
    },
    "Favorit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourite"
          }
        }
      }
    },
    "Favoriten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourites"
          }
        }
      }
    },
    "Fehler %lld vom Spark.": {
      "localizations": {
