      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to the microphone. Settings → Spark → Microphone."
          }
        }
      }
    },
    "Keine Antwort vom Spark.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer from the Spark."
          }
        }
      }
