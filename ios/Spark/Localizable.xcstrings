{
  "sourceLanguage": "de",
  "strings": {
    "%@\n\nNur koppeln, wenn das dein eigener Spark ist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nOnly pair if this is your own Spark."
          }
        }
      }
    },
    "%@ anrufen (%@)?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call %@ (%@)?"
          }
