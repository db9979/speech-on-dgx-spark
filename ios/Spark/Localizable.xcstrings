            "value": "Pair"
          }
        }
      }
    },
    "Kopple …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing …"
          }
        }
      }
    },
    "Kurz": {
      "localizations": {
