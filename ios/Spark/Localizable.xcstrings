            "value": "Shopping list"
          }
        }
      }
    },
    "Einschalten im Panel unter Ich → Nachrichten. Den Schalter für alle setzt der Admin unter Einstellungen → Funktionen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
