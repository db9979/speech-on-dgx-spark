{
  "sourceLanguage": "de",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spark"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For photos of letters or notes (only the text goes to the Spark) and for video calls with other profiles (the picture goes straight to the other person)."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that “Call …” finds the number. Contacts stay on the iPhone and do not go to the Spark."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that only you can start the Spark’s update."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can ask your Spark questions (the recording only goes to your own Spark) and for calls with other profiles (the sound goes straight to the other person)."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that the Spark’s reminders and shopping list are in the Reminders app after your “yes”. Nothing there is read for the Spark."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the wake word. Recognition runs only on the iPhone; nothing goes to Apple."
          }
        }
      }
    }
  },
  "version": "1.0"
}
