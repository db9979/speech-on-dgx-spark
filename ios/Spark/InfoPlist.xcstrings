{
  "sourceLanguage": "de",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spark"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can take a photo of a letter or a note. The iPhone reads the text itself; only the text goes to the Spark."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that “Call …” finds the number. Contacts stay on the iPhone and do not go to the Spark."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that only you can start the Spark’s update."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can ask your Spark questions. The recording only goes to your own Spark."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that the Spark’s reminders and shopping list are in the Reminders app after your “yes”. Nothing there is read for the Spark."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the wake word. Recognition runs only on the iPhone; nothing goes to Apple."
          }
        }
      }
    }
  },
  "version": "1.0"
}
