{
  "manifest_version": 3,
  "name": "Spark Schreibhilfe",
  "version": "1.0.0",
  "description": "Markierten Text mit dem eigenen Spark verbessern – Korrigieren, Glätten, Kürzer, Übersetzen. Der Text geht nur an deinen Spark.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["common.js", "background.js"]
  },
  "action": {
    "default_title": "Spark Schreibhilfe – markierten Text verbessern",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "verbessern": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Markierten Text mit der Standard-Aktion verbessern"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "schreibhilfe@speech-spark.local",
      "strict_min_version": "128.0"
    }
  }
}
